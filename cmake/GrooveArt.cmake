# ---------------------------------------------------------------------------
include_guard(GLOBAL)
# A plug-in's art (the mascot's frames), read by name like juce_add_binary_data:
#   NS::getNamedResource ("mira_0_png", size)
#
#   gk_add_art (Target HEADER_NAME X.h NAMESPACE NS SOURCES a.png b.png ...)
#   gk_bundle_art (PluginTarget ArtTarget)   # macOS: copies the art into the bundles
#
# Windows / Linux: juce_add_binary_data (the art inside the binary).
# macOS: the binaries are universal (x86_64 + arm64), so art inside them is
# stored twice, in each of the three formats: the suite's pkg went over 300 MB.
# There the files go to each bundle's Contents/Resources, once, and
# getNamedResource reads them from there (next to the binary that asks, found
# with dladdr), the first time, and keeps them (the pointer stays valid, like
# binary data). Not found there (the tests, the tools: not bundles): the
# source files, where they are in the repository.
# ---------------------------------------------------------------------------

function(gk_add_art target)
    cmake_parse_arguments(ART "" "HEADER_NAME;NAMESPACE" "SOURCES" ${ARGN})
    if(NOT APPLE)
        juce_add_binary_data(${target}
            HEADER_NAME ${ART_HEADER_NAME}
            NAMESPACE   ${ART_NAMESPACE}
            SOURCES     ${ART_SOURCES})
        set_target_properties(${target} PROPERTIES POSITION_INDEPENDENT_CODE ON)
        return()
    endif()

    set(dir "${CMAKE_CURRENT_BINARY_DIR}/${target}")
    set(table "")
    foreach(src IN LISTS ART_SOURCES)
        get_filename_component(file "${src}" NAME)
        string(MAKE_C_IDENTIFIER "${file}" id)
        string(APPEND table "        { \"${id}\", \"${file}\", \"${src}\" },\n")
    endforeach()

    file(WRITE "${dir}/include/${ART_HEADER_NAME}.in"
"#pragma once
// generated by gk_add_art (cmake/GrooveArt.cmake): the art, in the bundle's Resources
namespace ${ART_NAMESPACE}
{
    const char* getNamedResource (const char* resourceNameUTF8, int& dataSizeInBytes);
}
")
    configure_file("${dir}/include/${ART_HEADER_NAME}.in" "${dir}/include/${ART_HEADER_NAME}" COPYONLY)

    file(WRITE "${dir}/${target}.cpp.in"
"// generated by gk_add_art (cmake/GrooveArt.cmake)
#include \"${ART_HEADER_NAME}\"
#include <cstdio>
#include <cstring>
#include <dlfcn.h>
#include <map>
#include <mutex>
#include <string>
#include <vector>

namespace ${ART_NAMESPACE}
{
namespace
{
    struct Entry { const char* id; const char* file; const char* source; };
    const Entry entries[] {
${table}    };

    bool readFile (const std::string& path, std::vector<char>& out)
    {
        std::FILE* f = std::fopen (path.c_str(), \"rb\");
        if (f == nullptr)
            return false;
        std::fseek (f, 0, SEEK_END);
        const long n = std::ftell (f);
        std::fseek (f, 0, SEEK_SET);
        out.resize (n > 0 ? (size_t) n : 0);
        const bool ok = n > 0 && std::fread (out.data(), 1, out.size(), f) == out.size();
        std::fclose (f);
        return ok;
    }

    /** Contents/Resources of the bundle whose binary holds this code (Contents/MacOS/x). */
    std::string resourcesDir()
    {
        Dl_info info {};
        if (dladdr (reinterpret_cast<const void*> (&resourcesDir), &info) == 0 || info.dli_fname == nullptr)
            return {};
        std::string p (info.dli_fname);
        const auto slash = p.rfind ('/');
        return slash == std::string::npos ? std::string() : p.substr (0, slash) + \"/../Resources/\";
    }
} // namespace

const char* getNamedResource (const char* name, int& size)
{
    size = 0;
    if (name == nullptr)
        return nullptr;
    for (const auto& e : entries)
    {
        if (std::strcmp (e.id, name) != 0)
            continue;
        static std::mutex lock;
        static std::map<std::string, std::vector<char>> loaded;
        const std::lock_guard<std::mutex> guard (lock);
        auto it = loaded.find (e.id);
        if (it == loaded.end())
        {
            std::vector<char> data;
            static const std::string dir = resourcesDir();
            if (! readFile (dir + e.file, data) && ! readFile (e.source, data))
                return nullptr;
            it = loaded.emplace (e.id, std::move (data)).first;
        }
        size = (int) it->second.size();
        return it->second.data();
    }
    return nullptr;
}
} // namespace ${ART_NAMESPACE}
")
    configure_file("${dir}/${target}.cpp.in" "${dir}/${target}.cpp" COPYONLY)

    add_library(${target} STATIC "${dir}/${target}.cpp")
    target_include_directories(${target} INTERFACE "${dir}/include")
    target_include_directories(${target} PRIVATE "${dir}/include")
    target_compile_features(${target} PRIVATE cxx_std_17)
    set_target_properties(${target} PROPERTIES
        POSITION_INDEPENDENT_CODE ON
        GK_ART_FILES "${ART_SOURCES}")
endfunction()

# macOS: the art of ArtTarget into each of PluginTarget's bundles (VST3, AU,
# app), then the bundle signed again (ad hoc: the installers sign it for real).
function(gk_bundle_art plugin art)
    if(NOT APPLE)
        return()
    endif()
    get_target_property(files ${art} GK_ART_FILES)
    foreach(fmt VST3 AU Standalone)
        set(t ${plugin}_${fmt})
        if(NOT TARGET ${t})
            continue()
        endif()
        add_custom_command(TARGET ${t} POST_BUILD
            COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_BUNDLE_CONTENT_DIR:${t}>/Resources"
            COMMAND ${CMAKE_COMMAND} -E copy_if_different ${files} "$<TARGET_BUNDLE_CONTENT_DIR:${t}>/Resources/"
            COMMAND codesign --force --deep --sign - --preserve-metadata=entitlements,requirements,flags,runtime "$<TARGET_BUNDLE_DIR:${t}>"
            VERBATIM)
    endforeach()
endfunction()
